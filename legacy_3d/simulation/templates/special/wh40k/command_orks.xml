<?xml version="1.0" encoding="utf-8"?>
<!-- Comando da batalha da campanha (40k Wars): entidade invisível na borda do
     lado do jogador, de onde saem os poderes de apoio (estilo killstreak).
     maps/scripts/WH40KBattle.js a cria; simulation/components/ZZ_WH40KSupport.js
     só libera cada poder quando as baixas causadas enchem a barra dele.
     A recarga é curta: quem controla é a barra de baixas. -->
<Entity parent="special/actor">
  <Identity>
    <Civ>orks</Civ>
    <GenericName>Comando</GenericName>
    <Icon>special/orbital.png</Icon>
    <Undeletable>true</Undeletable>
  </Identity>
  <Ownership/>
  <AirSupportProvider>
    <drop_pod>
      <Cooldown>3</Cooldown>
      <Template>special/wh40k/ork_teleporta</Template>
      <Battalion datatype="tokens">units/orks/battalion_boyz</Battalion>
      <Name>Teleporta de Rapazes</Name>
    </drop_pod>
    <strategic_bomber>
      <Cooldown>3</Cooldown>
      <Template>special/wh40k/dakkajet_bomber</Template>
      <BombCount>8</BombCount>
      <BombingLength>60</BombingLength>
      <Name>Bombardeio de Dakkajets</Name>
    </strategic_bomber>
    <orbital_saturation>
      <Cooldown>3</Cooldown>
      <Template>special/wh40k/rokk_barrage</Template>
      <Name>Chuva de Rokks</Name>
    </orbital_saturation>
  </AirSupportProvider>
  <VisualActor disable=""/>
</Entity>

						<object name="codexIconTag[n]" type="text" ghost="true" size="4 100%-20 100%-4 100%-2" font="sans-bold-stroke-12" textcolor="250 225 150" text_align="center"/>
					</object>
				</repeat>
			</object>
		</object>

		<!-- ============================================== estatísticas (ui/Stats.js) -->
		<object name="statsDim" type="image" sprite="wh40kDim" size="0 0 100% 100%" hidden="true" z="195">
			<object name="statsPanel" type="image" sprite="wh40kPanel" size="50%-500 50%-340 50%+500 50%+340">
				<object name="statsTitle" type="text" size="20 12 100%-70 48" font="sans-bold-stroke-20" textcolor="235 205 125" text_valign="center"/>
				<object name="statsClose" type="button" style="wh40kButton" size="100%-50 14 100%-18 46" tooltip="Fechar (Esc)">X</object>
				<object name="statsChart" type="image" sprite="color:12 10 8 200" size="20 56 100%-220 356">
					<repeat count="320" var="n">
						<object name="statsBar[n]" type="image" ghost="true" hidden="true"/>
					</repeat>
				</object>
				<object name="statsAxis" type="text" size="20 358 100%-220 380" font="sans-12" textcolor="190 180 160"/>
				<object name="statsLegend" type="text" size="100%-210 56 100%-20 380" font="sans-13" textcolor="225 220 205"/>
				<object name="statsText" type="text" size="20 388 100%-20 100%-20" font="sans-13" textcolor="225 220 205" scrollbar="true" scrollbar_style="ModernScrollBar"/>
			</object>
		</object>

		<!-- ============================================== diálogo -->
		<object name="dialogDim" type="image" sprite="wh40kDim" size="0 0 100% 100%" hidden="true" z="200">
			<object name="dialog" type="image" sprite="wh40kPanel" size="50%-330 50%-230 50%+330 50%+230">
				<object name="dlgPortrait" type="image" size="16 16 144 144" hidden="true"/>
				<object name="dlgPortraitB" type="image" size="100%-144 16 100%-16 144" hidden="true"/>
				<object name="dlgTitle" type="text" size="16 16 100%-16 52" font="sans-bold-stroke-20" textcolor="235 205 125" text_align="center"/>
				<object name="dlgText" type="text" size="20 150 100%-20 100%-64" font="sans-14" textcolor="225 220 205" scrollbar="true" scrollbar_style="ModernScrollBar"/>
				<repeat count="10" var="n">
					<object name="dlgBtn[n]" type="button" style="wh40kButton" hidden="true"/>
				</repeat>
			</object>
		</object>

		<!-- ============================================== ficha grande da unidade (ui/UnitCard.js) -->
		<object name="cardDim" type="button" sprite="wh40kDim" size="0 0 100% 100%" hidden="true" z="220">
			<object name="cardPanel" type="image" sprite="wh40kPanel" size="50%-450 50%-270 50%+450 50%+270">
				<object name="cardBand" type="image" ghost="true" size="20 20 500 26"/>
				<object name="cardPortrait" type="image" ghost="true" size="24 34 496 506"/>
				<object type="image" sprite="wh40kPortraitFrame" ghost="true" size="18 28 502 512"/>
				<object name="cardTitle" type="text" ghost="true" size="520 22 100%-56 82" text_valign="center" font="sans-bold-stroke-20" textcolor="235 205 125"/>
				<object name="cardSubtitle" type="text" ghost="true" size="520 84 100%-20 108" font="sans-bold-14" textcolor="200 190 170"/>

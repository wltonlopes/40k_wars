<?xml version="1.0" encoding="utf-8"?>
<!--
	Página da campanha 40k Wars. Três vistas no mesmo lugar (mapArea):
	  systemView  sistema estelar: estrela, órbitas, planetas, luas, frotas
	  planetView  mapa do corpo: províncias, colmeias, exércitos, órbita
	  deployView  desdobramento tático e, depois, a batalha 2D em tempo real
	Efeitos animados (ui/Fx.js): planetFx, sysFx e battleFx.
	Painel lateral (side*) mostra o que está selecionado; dialog é a janela
	modal (batalha, relatórios, escolha da facção, fim de jogo).
	Os scripts: core/ (regras, sem interface) e ui/ (vistas e painéis).
-->
<objects>
	<script directory="gui/campaigns/wh40k/core/"/>
	<script directory="gui/campaigns/wh40k/ui/"/>

	<object name="wh40kRoot" type="image" sprite="wh40kBlack" size="0 0 100% 100%">
		<action on="Tick">if (g_WH40KPage) g_WH40KPage.tick();</action>
		<object hotkey="cancel">
			<action on="Press">if (g_WH40KPage) g_WH40KPage.cancel();</action>
		</object>

		<!-- ============================================== vistas -->
		<object name="mapArea" size="0 44 100%-370 100%-62">

			<!-- Sistema estelar -->
			<object name="systemView" type="image" sprite="stretched:campaigns/wh40k/system/background.png" size="0 0 100% 100%">
				<object name="sysStar" type="image" sprite="stretched:campaigns/wh40k/system/star.png" ghost="true"/>
				<repeat count="12" var="n">
					<object name="sysOrbit[n]" type="image" ghost="true" hidden="true"/>
				</repeat>
				<repeat count="12" var="n">
					<object name="sysRoute[n]" type="image" ghost="true" hidden="true"/>
				</repeat>
				<object name="sysHalo" type="image" ghost="true" hidden="true" sprite="color:230 190 90 255:textureAsMask:campaigns/wh40k/system/halo.png"/>
				<repeat count="12" var="n">
					<object name="sysBody[n]" type="button" hidden="true">
						<object name="sysBodyOwner[n]" type="image" ghost="true" size="10% 100%-6 90% 100%-2"/>
					</object>
					<object name="sysBodyLabel[n]" type="text" ghost="true" hidden="true" font="sans-bold-stroke-14" textcolor="230 215 180" text_align="center"/>
				</repeat>
				<repeat count="24" var="n">
					<object name="sysFleet[n]" type="button" hidden="true">
						<object name="sysFleetLabel[n]" type="text" ghost="true" size="0 100% 100% 100%+16" font="sans-bold-stroke-13" textcolor="255 255 255" text_align="center"/>
					</object>
				</repeat>
				<repeat count="16" var="n">
					<object name="sysFx[n]" type="image" ghost="true" hidden="true"/>
				</repeat>
				<object name="sysTitle" type="text" ghost="true" size="16 8 60% 40" font="sans-bold-stroke-20" textcolor="230 200 120"/>
				<object name="sysHint" type="text" ghost="true" size="16 40 70% 64" font="sans-stroke-14" textcolor="200 190 170"/>
			</object>

			<!-- Mapa do planeta -->
			<object name="planetView" hidden="true" size="0 0 100% 100%">
				<object type="image" sprite="stretched:campaigns/wh40k/system/background.png" size="0 0 100% 100%" ghost="true"/>
				<object name="planetMap" type="image" ghost="true"/>
				<repeat count="24" var="n">
					<object name="prov[n]" type="button" hidden="true"/>
				</repeat>
				<repeat count="24" var="n">
					<object name="provPlate[n]" type="image" ghost="true" hidden="true" sprite="wh40kLabelPlate"/>
					<object name="provLabel[n]" type="text" ghost="true" hidden="true" font="sans-bold-stroke-13" textcolor="240 230 200" text_align="center" text_valign="center"/>
					<object name="provHive[n]" type="image" ghost="true" hidden="true"/>
					<object name="provFort[n]" type="image" ghost="true" hidden="true"/>
					<object name="provYard[n]" type="image" ghost="true" hidden="true"/>
					<object name="provGarrison[n]" type="text" ghost="true" hidden="true" font="sans-bold-stroke-12" textcolor="255 255 255" text_align="left" text_valign="center"/>
					<object name="provTarget[n]" type="image" ghost="true" hidden="true"/>
				</repeat>
				<repeat count="16" var="n">
					<object name="armyRing[n]" type="image" ghost="true" hidden="true"/>
					<object name="army[n]" type="button" hidden="true">
						<object name="armyCount[n]" type="text" ghost="true" size="0 100%-14 100% 100%+2" font="sans-bold-stroke-12" textcolor="255 255 255" text_align="center"/>
					</object>
				</repeat>
				<repeat count="32" var="n">
					<object name="planetFx[n]" type="image" ghost="true" hidden="true"/>
				</repeat>
				<object name="orbitBar" type="image" sprite="wh40kBar" size="0 0 100% 34">
					<object name="orbitText" type="text" ghost="true" size="10 0 100%-420 100%" font="sans-bold-stroke-14" textcolor="230 210 160" text_valign="center"/>
					<repeat count="4" var="n">
						<object name="orbitFleet[n]" type="button" style="wh40kButton" hidden="true" font="sans-bold-13"/>
					</repeat>
				</object>
				<object name="planetHint" type="text" ghost="true" size="12 100%-22 100%-12 100%-2" font="sans-stroke-13" textcolor="210 200 180"/>
				<object name="planetThreatBtn" type="button" style="wh40kButton" size="100%-176 40 100%-8 68" font="sans-bold-12" tooltip="Mapa de ameaça: suas províncias em perigo (vermelho) e os alvos fáceis (verde).">Mapa de ameaça</object>
				<object name="planetUndoBtn" type="button" style="wh40kButton" size="100%-176 72 100%-8 100" font="sans-bold-12" hidden="true">Desfazer movimento</object>
			</object>

			<!-- Batalha espacial (ui/SpaceView.js) -->
			<object name="spaceView" hidden="true" size="0 0 100% 100%">
				<object name="spaceBg" type="image" sprite="stretched:campaigns/wh40k/system/background.png" ghost="true" size="0 0 100% 100%"/>
				<object name="spacePlanet" type="image" ghost="true"/>
				<repeat count="32" var="n">
					<object name="spaceShip[n]" type="image" ghost="true" hidden="true"/>
				</repeat>
				<repeat count="48" var="n">
					<object name="spaceBolt[n]" type="image" ghost="true" hidden="true"/>
				</repeat>
				<repeat count="24" var="n">
					<object name="spaceFx[n]" type="image" ghost="true" hidden="true"/>
				</repeat>
				<object name="spaceTitle" type="text" ghost="true" size="12 6 100%-12 34" font="sans-bold-stroke-20" textcolor="230 200 120"/>
				<object name="spaceHud" type="text" ghost="true" size="12 36 100%-12 62" font="sans-bold-stroke-16" textcolor="240 230 200"/>
				<object name="spaceSkip" type="button" style="wh40kButton" size="100%-160 100%-46 100%-12 100%-10">Pular</object>
			</object>

			<!-- Desdobramento tático -->
			<object name="deployView" hidden="true" size="0 0 100% 100%">
				<object type="image" sprite="wh40kBlack" size="0 0 100% 100%" ghost="true"/>
				<object name="deployField" type="button">
					<object name="deployGround" type="image" ghost="true" size="0 0 100% 100%"/>
					<object name="deployCity" type="image" ghost="true" hidden="true"/>
					<repeat count="48" var="n">
						<object name="deployFeature[n]" type="image" ghost="true" hidden="true"/>
					</repeat>
					<object name="deployWeather" type="image" ghost="true" hidden="true" size="0 0 100% 100%"/>
					<object name="deployEnemyZone" type="image" sprite="wh40kEnemyZone" ghost="true" size="0 4% 100% 24%"/>
					<object name="deployOwnZone" type="image" sprite="wh40kDeployZone" ghost="true" size="0 76% 100% 96%"/>
					<!-- Anéis de alcance da artilharia: a selecionada (dourado) e a inimiga sob o mouse (vermelho). -->
					<object name="battleRange" type="image" ghost="true" hidden="true"/>
					<object name="battleRangeEnemy" type="image" ghost="true" hidden="true"/>
					<object name="deploySelRing" type="image" ghost="true" hidden="true"/>
					<repeat count="24" var="n">
						<object name="deployEnemy[n]" type="button" hidden="true">
							<object name="deployEnemyHit[n]" type="image" ghost="true" hidden="true" size="-4 -4 100%+4 100%+4" sprite="color:255 50 20 210:textureAsMask:campaigns/wh40k/icons/disc.png"/>
							<repeat count="6" var="k">
								<object name="deployEnemyFig[n][k]" type="image" ghost="true" hidden="true"/>
							</repeat>
							<object name="deployEnemyBar[n]" type="image" ghost="true" hidden="true" sprite="color:230 80 60 255"/>
						</object>
					</repeat>
					<repeat count="24" var="n">
						<object name="deployToken[n]" type="button" hidden="true">
							<object name="deployTokenHit[n]" type="image" ghost="true" hidden="true" size="-4 -4 100%+4 100%+4" sprite="color:255 50 20 210:textureAsMask:campaigns/wh40k/icons/disc.png"/>
							<repeat count="6" var="k">
								<object name="deployTokenFig[n][k]" type="image" ghost="true" hidden="true"/>
							</repeat>
							<object name="deployTokenBar[n]" type="image" ghost="true" hidden="true" sprite="color:90 200 90 255"/>
							<object name="deployTokenOrder[n]" type="text" ghost="true" size="-20 100% 100%+20 100%+16" font="sans-bold-stroke-12" textcolor="255 230 150" text_align="center"/>
						</object>
					</repeat>
					<!-- Projéteis: traçantes orientados (ui/Shots.js). -->
					<repeat count="64" var="n">
						<object name="battleShot[n]" type="image" ghost="true" hidden="true"/>
					</repeat>
					<repeat count="40" var="n">
						<object name="battleFx[n]" type="image" ghost="true" hidden="true"/>
					</repeat>
					<object name="battleCursor" type="image" ghost="true" hidden="true"/>
					<repeat count="20" var="n">
						<object name="deployArrow[n]" type="image" ghost="true" hidden="true"/>
					</repeat>
				</object>
				<object name="deployTitle" type="text" ghost="true" size="12 6 100%-12 34" font="sans-bold-stroke-20" textcolor="230 200 120"/>
				<object name="battleHud" hidden="true" ghost="true" size="100%-432 8 100%-12 34">
					<object type="image" sprite="color:20 16 12 220" ghost="true" size="0 0 100% 100%"/>
					<object name="battleBar1" type="image" ghost="true" sprite="color:90 200 90 255" size="4 4 50% 100%-4"/>
					<object name="battleBar2" type="image" ghost="true" sprite="color:220 70 50 255" size="50% 4 100%-4 100%-4"/>
					<object name="battleHudText" type="text" ghost="true" size="0 0 100% 100%" font="sans-bold-stroke-14" textcolor="255 255 255" text_align="center" text_valign="center"/>
				</object>
				<object name="battleMsg" type="text" ghost="true" hidden="true" size="12 40 360 200" font="sans-bold-stroke-14" textcolor="240 230 200"/>
				<object name="deployHint" type="text" ghost="true" size="12 100%-28 100%-12 100%-4" font="sans-stroke-14" textcolor="210 200 180"/>
			</object>
		</object>

		<!-- ============================================== barra superior -->
		<object name="topBar" type="image" sprite="wh40kBar" size="0 0 100% 44">
			<object name="topEmblem" type="image" size="6 4 42 40"/>
			<object name="topFaction" type="text" size="50 0 282 100%" font="sans-bold-stroke-16" textcolor="230 200 120" text_valign="center"/>
			<object name="topFunds" type="text" size="286 0 446 100%" font="sans-bold-stroke-16" textcolor="240 230 200" text_valign="center"/>
			<object name="topSpecial" type="button" size="448 4 604 40" sprite_over="wh40kRowOver">
				<object name="topSpecialIcon" type="image" ghost="true" size="2 2 34 34"/>
				<object name="topSpecialText" type="text" ghost="true" size="38 0 100% 100%" font="sans-bold-stroke-14" textcolor="240 205 140" text_valign="center"/>
			</object>
			<object name="topTurn" type="text" size="612 3 100%-540 23" font="sans-bold-stroke-14" textcolor="240 230 200"/>
			<object name="topObjective" type="text" size="612 23 100%-540 43" font="sans-stroke-13" textcolor="210 190 150"/>
			<object name="btnSystem" type="button" style="wh40kButton" size="100%-534 6 100%-438 38">Sistema</object>
			<object name="btnPlanet" type="button" style="wh40kButton" size="100%-434 6 100%-338 38">Planeta</object>
			<object name="btnLog" type="button" style="wh40kButton" size="100%-334 6 100%-238 38">Registro</object>
			<object name="btnEndTurn" type="button" style="wh40kButton" size="100%-234 6 100%-86 38">Encerrar Turno</object>
			<object name="btnMenu" type="button" style="wh40kButton" size="100%-82 6 100%-6 38">Sair</object>
		</object>

		<!-- ============================================== painel lateral -->
		<object name="side" type="image" sprite="wh40kPanel" size="100%-370 44 100% 100%">
			<object name="sidePortrait" type="image" size="12 12 108 108" hidden="true"/>
			<object name="sidePortraitFrame" type="image" sprite="wh40kPortraitFrame" ghost="true" size="10 10 110 110" hidden="true"/>
			<object name="sidePortraitBtn" type="button" size="10 10 110 110" hidden="true" tooltip="Clique: ficha completa"/>
			<object name="sideTitle" type="text" size="118 10 100%-10 40" font="sans-bold-stroke-16" textcolor="235 205 125"/>
			<object name="sideSubtitle" type="text" size="118 40 100%-10 64" font="sans-14" textcolor="200 190 170"/>
			<object name="sideQuote" type="text" size="118 64 100%-10 116" font="sans-bold-13" textcolor="250 225 150" hidden="true"/>
			<object name="sideText" type="text" size="12 118 100%-12 230" font="sans-14" textcolor="220 215 200" scrollbar="true" scrollbar_style="ModernScrollBar"/>
			<repeat count="14" var="n">
				<object name="sideRow[n]" type="button" sprite="wh40kRow" sprite_over="wh40kRowOver" hidden="true">
					<object name="sideRowIcon[n]" type="image" ghost="true" size="2 2 36 36"/>
					<object name="sideRowBar[n]" type="image" ghost="true" size="2 36 36 39" sprite="color:90 200 90 255"/>
					<object name="sideRowText[n]" type="text" ghost="true" size="42 0 100%-92 100%" font="sans-13" textcolor="230 225 210" text_valign="center"/>
					<object name="sideRowBtn[n]" type="button" style="wh40kButton" size="100%-88 5 100%-4 100%-5" font="sans-bold-12" hidden="true"/>
				</object>
			</repeat>
			<repeat count="12" var="n">
				<object name="sideAction[n]" type="button" style="wh40kButton" hidden="true" font="sans-bold-13"/>
			</repeat>
		</object>

		<!-- ============================================== registro -->
		<object name="bottomBar" type="image" sprite="wh40kPanel" size="0 100%-62 100%-370 100%">
			<object name="logText" type="text" size="10 5 100%-10 100%-5" font="sans-13" textcolor="215 205 185"/>
		</object>

		<!-- ============================================== seletor em grade (ui/Selector.js, no estilo do civ_grid) -->
		<object name="selDim" type="image" sprite="wh40kDim" size="0 0 100% 100%" hidden="true" z="180">
			<object name="selPanel" type="image" sprite="wh40kPanel" size="3% 4% 97% 96%">
				<object name="selTitle" type="text" size="20 10 100%-20 44" font="sans-bold-stroke-20" textcolor="235 205 125" text_align="center" text_valign="center"/>
				<!-- grade -->
				<object name="selGrid" size="16 52 100%-412 100%-52">
					<repeat count="48" var="n">
						<object name="selItem[n]" type="button" hidden="true" sprite="color:30 24 18 220" sprite_over="color:120 90 40 200">
							<object name="selItemFrame[n]" type="image" ghost="true" size="0 0 100% 100%" sprite="wh40kPortraitFrame"/>
							<object name="selItemImg[n]" type="image" ghost="true" size="8 6 100%-8 100%-26"/>
							<object name="selItemName[n]" type="text" ghost="true" size="2 100%-26 100%-2 100%-2" font="sans-bold-stroke-13" textcolor="240 225 190" text_align="center" text_valign="center"/>
						</object>
					</repeat>
				</object>
				<!-- paginação e zoom -->
				<object size="16 100%-46 100%-412 100%-12">
					<object name="selPageStatus" type="text" size="0 0 220 100%" font="sans-bold-stroke-14" textcolor="230 210 160" text_valign="center"/>
					<object name="selPrev" type="button" style="wh40kButton" size="230 0 330 100%">&lt; Anterior</object>
					<object name="selNext" type="button" style="wh40kButton" size="336 0 436 100%">Próxima &gt;</object>
					<object name="selZoomIn" type="button" style="wh40kButton" size="100%-80 0 100%-42 100%" tooltip="Cartões maiores">+</object>
					<object name="selZoomOut" type="button" style="wh40kButton" size="100%-38 0 100% 100%" tooltip="Cartões menores">−</object>
				</object>
				<!-- painel direito -->
				<object size="100%-400 52 100%-16 100%-12">
					<object type="text" size="0 0 90 30" font="sans-bold-14" textcolor="230 210 160" text_valign="center">Buscar:</object>
					<object name="selSearch" type="input" style="ModernInput" font="sans-16" size="92 2 100% 30"/>
					<object name="selFilterLabel[0]" type="text" size="0 36 90 66" font="sans-bold-14" textcolor="230 210 160" text_valign="center"/>
					<object name="selFilter[0]" type="dropdown" style="ModernDropDown" size="92 38 100% 64"/>
					<object name="selFilterLabel[1]" type="text" size="0 70 90 100" font="sans-bold-14" textcolor="230 210 160" text_valign="center"/>
					<object name="selFilter[1]" type="dropdown" style="ModernDropDown" size="92 72 100% 98"/>
					<object name="selPreview" type="image" size="50%-110 108 50%+110 328"/>
					<object name="selPreviewFrame" type="image" sprite="wh40kPortraitFrame" ghost="true" size="50%-112 106 50%+112 330"/>
					<object name="selName" type="text" size="0 334 100% 364" font="sans-bold-stroke-20" textcolor="235 205 125" text_align="center" text_valign="center"/>
					<object name="selInfo" type="text" size="0 366 100% 388" font="sans-bold-13" textcolor="200 190 170" text_align="center" text_valign="center"/>
					<object name="selDesc" type="text" size="4 392 100%-4 100%-110" font="sans-13" textcolor="225 220 205" scrollbar="true" scrollbar_style="ModernScrollBar"/>
					<object name="selExtraLabel" type="text" size="0 100%-104 90 100%-74" font="sans-bold-14" textcolor="230 210 160" text_valign="center"/>
					<object name="selExtra" type="dropdown" style="ModernDropDown" size="92 100%-102 100% 100%-76"/>
					<object name="selRandom" type="button" style="wh40kButton" size="0 100%-70 50%-3 100%-38">Aleatório</object>
					<object name="selAux" type="button" style="wh40kButton" size="50%+3 100%-70 100% 100%-38"/>
					<object name="selCancel" type="button" style="wh40kButton" size="0 100%-34 50%-3 100%">Voltar</object>
					<object name="selOk" type="button" style="wh40kButton" size="50%+3 100%-34 100% 100%">Escolher</object>
				</object>
			</object>
		</object>

		<!-- ============================================== códex (ui/Codex.js) -->
		<object name="codexDim" type="image" sprite="wh40kDim" size="0 0 100% 100%" hidden="true" z="190">
			<object name="codexPanel" type="image" sprite="wh40kPanel" size="50%-570 50%-390 50%+570 50%+390">
				<object name="codexTitle" type="text" size="230 12 100%-70 48" font="sans-bold-stroke-20" textcolor="235 205 125" text_valign="center"/>
				<object name="codexClose" type="button" style="wh40kButton" size="100%-50 14 100%-18 46" tooltip="Fechar (Esc)">X</object>
				<object name="codexHeader" type="text" size="20 14 220 48" font="sans-bold-stroke-16" textcolor="235 205 125" text_valign="center">CÓDEX</object>
				<repeat count="26" var="n">
					<object name="codexFac[n]" type="button" style="wh40kButton" font="sans-bold-12" hidden="true"/>
				</repeat>
				<object name="codexText" type="text" size="232 50 100%-20 176" font="sans-13" textcolor="225 220 205" scrollbar="true" scrollbar_style="ModernScrollBar"/>
				<repeat count="48" var="n">
					<object name="codexIcon[n]" type="button" sprite_over="wh40kRowOver" hidden="true">
